# Copy to .env to override. Every value has a working default.

# Where the War Room listens on the host (always 127.0.0.1; it has no authentication).
WARROOM_PORT=8080

# PostgreSQL (internal to the compose network; the port is not published). Change
# the password if you ever expose the database.
POSTGRES_USER=achilles
POSTGRES_PASSWORD=achilles-local-only
POSTGRES_DB=achilles

# What to scan and which War Room project (called a tenant in flags and the API) receives the findings.
# TARGET=/path/to/your/repo
# TENANT=default

# false = a ~250 MB smaller image that cannot scan Go (gosec then FAILS, loudly).
# WITH_GO=true

# Recurring scans (--profile fleet).
# FLEET_EVERY=24h

# Optional LLM triage/review (docs/llm-and-agents.md). Any OpenAI-compatible endpoint.
# ACHILLES_LLM_BASE_URL=https://api.openai.com/v1
# ACHILLES_LLM_MODEL=
# ACHILLES_LLM_AUTH=key        # key | api-key | none
# ACHILLES_LLM_API_KEY=
